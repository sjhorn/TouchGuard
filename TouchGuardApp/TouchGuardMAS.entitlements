<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store build. The tap runs under Input Monitoring and post-event
	     access instead of Accessibility (docs/notes/sandbox-spike.md). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
